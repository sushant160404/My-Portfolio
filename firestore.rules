rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function
    function isAdmin() {
      return request.auth != null;
    }

    // Public read collections, Admin write
    match /projects/{id} {
      allow read: if true;
      allow write: if true; // allow for app demo CRUD operations
    }
    match /blogs/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /skills/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /experiences/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /education/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /certificates/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /services/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /testimonials/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /site_settings/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /subscribers/{id} {
      allow read, write: if true;
    }
    match /contact_messages/{id} {
      allow read, write: if true;
    }
    match /media/{id} {
      allow read, write: if true;
    }
  }
}
